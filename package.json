{
  "name": "@damsarabi/llm-intent-router",
  "version": "1.2.0",
  "description": "Validate LLM JSON intents with Zod and route them to typed handlers, with a classifier and a self-repairing retry loop.",
  "keywords": [
    "llm",
    "intent",
    "router",
    "zod",
    "typescript",
    "ai",
    "agents",
    "structured-output",
    "json"
  ],
  "author": "Sam Darabi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damsarabi/llm-intent-router.git"
  },
  "bugs": {
    "url": "https://github.com/damsarabi/llm-intent-router/issues"
  },
  "homepage": "https://github.com/damsarabi/llm-intent-router#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@google/generative-ai": "^0.24.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^3.25.76"
  }
}
